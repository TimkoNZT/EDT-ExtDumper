<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.commands">
      <command
            id="com.nzt.edt.extdumper.generate"
            name="%generateDumpCommandName">
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            class="com.nzt.edt.extdumper.GenerateDumpHandler"
            commandId="com.nzt.edt.extdumper.generate">
         <activeWhen>
            <with variable="selection">
               <iterate ifEmpty="false">
                  <or>
                     <instanceof value="com._1c.g5.v8.dt.metadata.mdclass.ExternalDataProcessor"/>
                     <instanceof value="com._1c.g5.v8.dt.metadata.mdclass.ExternalReport"/>
                     <instanceof value="org.eclipse.core.resources.IResource"/>
                  </or>
               </iterate>
            </with>
         </activeWhen>
      </handler>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution
            allPopups="false"
            locationURI="popup:com._1c.g5.v8.dt.navigator.ui.navigator.popup?after=group.edit">
         <command
               commandId="com.nzt.edt.extdumper.generate"
               icon="icons/dump.png"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <iterate ifEmpty="false">
                     <or>
                        <instanceof value="com._1c.g5.v8.dt.metadata.mdclass.ExternalDataProcessor"/>
                        <instanceof value="com._1c.g5.v8.dt.metadata.mdclass.ExternalReport"/>
                     </or>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution
            allPopups="false"
            locationURI="popup:org.eclipse.ui.navigator.ProjectExplorer#PopupMenu?after=group.edit">
         <command
               commandId="com.nzt.edt.extdumper.generate"
               icon="icons/dump.png"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activeMenuSelection">
                  <iterate ifEmpty="false">
                     <or>
                        <instanceof value="com._1c.g5.v8.dt.metadata.mdclass.ExternalDataProcessor"/>
                        <instanceof value="com._1c.g5.v8.dt.metadata.mdclass.ExternalReport"/>
                        <instanceof value="org.eclipse.core.resources.IResource"/>
                     </or>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

</plugin>
